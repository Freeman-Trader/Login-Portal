<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apex Financial Portal — Register</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --bg-primary: #0a0e17; --bg-secondary: #111827; --bg-card: #1a1f2e;
            --border: #2a3042; --border-focus: #3b82f6; --accent: #3b82f6;
            --accent-glow: rgba(59, 130, 246, 0.15); --text-primary: #e2e8f0;
            --text-secondary: #94a3b8; --text-muted: #64748b;
            --danger: #ef4444; --success: #22c55e;
        }
        body {
            font-family: 'IBM Plex Sans', sans-serif; background: var(--bg-primary);
            color: var(--text-primary); min-height: 100vh;
            display: flex; flex-direction: column; overflow: hidden;
        }
        body::before {
            content: ''; position: fixed; inset: 0;
            background-image:
                linear-gradient(rgba(59,130,246,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(59,130,246,0.03) 1px, transparent 1px);
            background-size: 60px 60px; animation: gridShift 20s linear infinite; z-index: 0;
        }
        @keyframes gridShift { 0%{transform:translate(0,0)} 100%{transform:translate(60px,60px)} }
        .main-wrapper { flex:1; display:flex; align-items:center; justify-content:center; position:relative; z-index:1; padding:2rem; }
        .login-container { width:100%; max-width:420px; animation: fadeUp 0.6s ease-out; }
        @keyframes fadeUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
        .brand { text-align:center; margin-bottom:2.5rem; }
        .brand-icon { width:48px; height:48px; background:linear-gradient(135deg,var(--accent),#60a5fa); border-radius:12px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:1rem; box-shadow:0 0 30px var(--accent-glow); }
        .brand-icon svg { width:24px; height:24px; }
        .brand h1 { font-family:'JetBrains Mono',monospace; font-size:1.25rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; }
        .brand p { font-size:0.8rem; color:var(--text-muted); margin-top:0.25rem; letter-spacing:0.15em; text-transform:uppercase; }
        .card { background:var(--bg-card); border:1px solid var(--border); border-radius:16px; padding:2rem; backdrop-filter:blur(12px); }
        .card-header { margin-bottom:1.75rem; }
        .card-header h2 { font-size:1.1rem; font-weight:600; }
        .card-header p { font-size:0.825rem; color:var(--text-secondary); margin-top:0.35rem; }
        .form-group { margin-bottom:1.25rem; }
        .form-group label { display:block; font-size:0.75rem; font-weight:500; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.5rem; }
        .form-group input { width:100%; padding:0.75rem 1rem; background:var(--bg-secondary); border:1px solid var(--border); border-radius:8px; color:var(--text-primary); font-family:'IBM Plex Sans',sans-serif; font-size:0.9rem; transition:border-color 0.2s, box-shadow 0.2s; outline:none; }
        .form-group input::placeholder { color:var(--text-muted); }
        .form-group input:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-glow); }
        .btn-primary { width:100%; padding:0.8rem; background:var(--accent); color:#fff; border:none; border-radius:8px; font-family:'IBM Plex Sans',sans-serif; font-size:0.9rem; font-weight:600; cursor:pointer; transition:background 0.2s, transform 0.1s, box-shadow 0.2s; margin-top:0.5rem; }
        .btn-primary:hover { background:#2563eb; box-shadow:0 4px 20px var(--accent-glow); }
        .btn-primary:active { transform:scale(0.98); }
        .alt-link { text-align:center; margin-top:1.25rem; font-size:0.825rem; color:var(--text-secondary); }
        .alt-link a { color:var(--accent); text-decoration:none; font-weight:500; transition:color 0.2s; }
        .alt-link a:hover { color:#60a5fa; }
        .flash-messages { margin-bottom:1rem; }
        .flash-msg { padding:0.65rem 1rem; border-radius:8px; font-size:0.825rem; background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.25); color:#fca5a5; }
        .flash-msg.success { background:rgba(34,197,94,0.1); border-color:rgba(34,197,94,0.25); color:#86efac; }
        .status-bar { position:fixed; bottom:0; left:0; right:0; background:var(--bg-secondary); border-top:1px solid var(--border); padding:0.5rem 1.5rem; display:flex; align-items:center; justify-content:space-between; font-family:'JetBrains Mono',monospace; font-size:0.65rem; color:var(--text-muted); z-index:10; }
        .status-dot { width:6px; height:6px; background:var(--success); border-radius:50%; display:inline-block; margin-right:6px; animation:pulse 2s infinite; }
        @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
        .status-left,.status-right { display:flex; align-items:center; gap:1.5rem; }
        .status-item { display:flex; align-items:center; gap:4px; }
    </style>
</head>
<body>
    <div class="main-wrapper">
        <div class="login-container">
            <div class="brand">
                <div class="brand-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <line x1="19" y1="8" x2="19" y2="14"/>
                        <line x1="22" y1="11" x2="16" y2="11"/>
                    </svg>
                </div>
                <h1>Apex Financial</h1>
                <p>Secure Operations Portal</p>
            </div>

            {% with messages = get_flashed_messages() %}
            {% if messages %}
            <div class="flash-messages">
                {% for msg in messages %}
                <div class="flash-msg {% if 'created' in msg.lower() %}success{% endif %}">{{ msg }}</div>
                {% endfor %}
            </div>
            {% endif %}
            {% endwith %}

            <div class="card">
                <div class="card-header">
                    <h2>Create Account</h2>
                    <p>Register for portal access</p>
                </div>
                <form method="POST">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" placeholder="Choose a username" required autofocus>
                    </div>
                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Create a password" required>
                    </div>
                    <button type="submit" class="btn-primary">Create Account</button>
                </form>
                <div class="alt-link">
                    Already have an account? <a href="/login">Sign in</a>
                </div>
            </div>
        </div>
    </div>

    <div class="status-bar">
        <div class="status-left">
            <div class="status-item"><span class="status-dot"></span> Systems Operational</div>
            <div class="status-item">TLS 1.3 Encrypted</div>
        </div>
        <div class="status-right">
            <div class="status-item">Host: {{ host_name }}</div>
            <div class="status-item">IP: {{ host_ip }}</div>
        </div>
    </div>
</body>
</html>
